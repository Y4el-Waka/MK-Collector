# Required RouterOS connection
MIKROTIK_URL=http://192.0.2.1
MIKROTIK_USER=collector
MIKROTIK_PASS=CHANGE_ME

# Physical RouterOS interfaces
CUSTOMER_INTERFACE=ether1
UPLINK_INTERFACE=sfp-sfpplus1

# Collection and retention
TRAFFIC_INTERVAL=1
DDM_INTERVAL=5
HISTORY_RETENTION_HOURS=3

# Optional
ROUTEROS_TIMEOUT=4
DEVICE_NAME=EXAMPLE-ROUTER
DATABASE_PATH=mk_collector.sqlite3
